# Ditanam saat build (npm run build) dan terlihat publik di JS yang terkirim ke
# browser: jangan menaruh rahasia apa pun di variabel VITE_*.
#
# Kosong = path relatif /api/... lewat proxy Vite (dev lokal, default). Isi
# dengan origin API (tanpa trailing slash) untuk deploy lintas-subdomain,
# misal https://api.contoh-domain.id
VITE_API_URL=

# Nomor WhatsApp Admin untuk kartu "Ada kendala pembayaran?" di halaman
# Langganan, format internasional tanpa tanda plus (misalnya 628123456789).
# Kosong = kartu dan tautan "Hubungi Admin" disembunyikan.
VITE_NOMOR_WA_ADMIN=
